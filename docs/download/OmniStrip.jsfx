slider1:0<-24,24,0.1>-IN - Input Gain (dB)
slider2:0<0,1,1{Off,On}>-IN - HPF
slider3:80<20,500,1:log>-IN - HPF Freq (Hz)
slider4:0<0,1,1{Off,On}>-IN - LPF
slider5:18000<3000,20000,10:log>-IN - LPF Freq (Hz)
slider6:0<0,100,0.1>-IN - Drive (%)
slider7:0<0,1,1{Normal,Invertida}>-IN - Phase Invert
slider8:1<0,1,1{On,Bypass}>-GATE - Bypass
slider9:-50<-80,0,0.1>-GATE - Threshold (dB)
slider10:1<0.1,50,0.1:log>-GATE - Attack (ms)
slider11:150<10,1000,1:log>-GATE - Release (ms)
slider12:-40<-60,0,0.1>-GATE - Range (dB)
slider13:0<0,1,1{EQ to COMP,COMP to EQ}>-ROUTE - Order
slider14:0<0,1,1{On,Bypass}>-EQ - Bypass
slider15:100<40,500,1:log>-EQ - Low Shelf Freq (Hz)
slider16:0<-15,15,0.1>-EQ - Low Shelf Gain (dB)
slider17:400<100,3000,1:log>-EQ - Low Mid Freq (Hz)
slider18:1<0.5,4,0.01>-EQ - Low Mid Q
slider19:0<-15,15,0.1>-EQ - Low Mid Gain (dB)
slider20:3000<800,10000,1:log>-EQ - High Mid Freq (Hz)
slider21:1<0.5,4,0.01>-EQ - High Mid Q
slider22:0<-15,15,0.1>-EQ - High Mid Gain (dB)
slider23:8000<3000,16000,10:log>-EQ - High Shelf Freq (Hz)
slider24:0<-15,15,0.1>-EQ - High Shelf Gain (dB)
slider25:1<0,1,1{On,Bypass}>-COMP - Bypass
slider26:0<-60,0,0.1>-COMP - Threshold (dB)
slider27:3<1,20,0.1>-COMP - Ratio (x:1)
slider28:10<0.5,100,0.1:log>-COMP - Attack (ms)
slider29:150<10,1000,1:log>-COMP - Release (ms)
slider30:0<0,300,1>-COMP - Sidechain HPF (Hz, abaixo de 20 = Off)
slider31:0<-12,24,0.1>-COMP - Makeup Gain (dB)
slider32:0.8<0.05,8,0.01:log>-CHORUS - Rate (Hz)
slider33:40<0,100,0.1>-CHORUS - Depth (%)
slider34:0<0,100,0.1>-CHORUS - Mix (%)
slider35:0<0,12,1{Free (ms),1/1,1/2,1/4 D,1/4,1/4 T,1/8 D,1/8,1/8 T,1/16 D,1/16,1/16 T,1/32}>-DELAY - Sync
slider36:350<1,2000,1:log>-DELAY - Time (ms)
slider37:30<0,95,0.1>-DELAY - Feedback (%)
slider38:0<0,100,0.1>-DELAY - Mix (%)
slider39:50<0,100,0.1>-REVERB - Room Size (%)
slider40:50<0,100,0.1>-REVERB - High Damping (%)
slider41:0<0,100,0.1>-REVERB - Mix (%)
slider42:100<0,200,0.1>-OUT - Stereo Width (%)
slider43:0<-24,12,0.1>-OUT - Output Trim (dB)
slider44:0<-100,100,0.1>-OUT - Pan (%)
slider45:0<0,1,1{Off,Mute}>-OUT - Mute
slider46:0<0,1,1{Stereo,Mono}>-OUT - Mono
slider47:0<0,1,1{Console,Fita de rolo}>-IN - Saturation Type
options:gmem=OmniStrip
in_pin:Left In
in_pin:Right In
out_pin:Left Out
out_pin:Right Out
@init
om_versao = 102;
function alloc(n) local(p) ( p = mem_top; mem_top += n; p );
function db2lin(x) ( exp(x * 0.11512925464970228) );
function lin2db(x) ( log(max(x, 0.0000001)) * 8.685889638065035 );
function tanh_(x) local(e) ( e = exp(2 * max(-12, min(12, x))); (e - 1) / (e + 1) );
function sm_tick() instance(v, t) ( v += sm_c * (t - v); );
function sm_ctl()  instance(v, t) ( v += ctl_c * (t - v); );
function sm_snap() instance(v, t) ( v = t; );
function sm_near() instance(v, t) ( abs(t - v) < 0.0000001 ? v = t; );
function svf_hp(f, q) instance(a1, a2, a3, m0, m1, m2) local(g, k)
(
g = tan($pi * min(f, srate * 0.49) / srate); k = 1 / q;
a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
m0 = 1; m1 = -k; m2 = -1;
);
function svf_lp(f, q) instance(a1, a2, a3, m0, m1, m2) local(g, k)
(
g = tan($pi * min(f, srate * 0.49) / srate); k = 1 / q;
a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
m0 = 0; m1 = 0; m2 = 1;
);
function svf_bell(f, q, db) instance(a1, a2, a3, m0, m1, m2) local(g, k, aa)
(
aa = exp(db * 0.05756462732485114);
g = tan($pi * min(f, srate * 0.49) / srate); k = 1 / (q * aa);
a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
m0 = 1; m1 = k * (aa * aa - 1); m2 = 0;
);
function svf_ls(f, q, db) instance(a1, a2, a3, m0, m1, m2) local(g, k, aa)
(
aa = exp(db * 0.05756462732485114);
g = tan($pi * min(f, srate * 0.49) / srate) / sqrt(aa); k = 1 / q;
a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
m0 = 1; m1 = k * (aa - 1); m2 = aa * aa - 1;
);
function svf_hs(f, q, db) instance(a1, a2, a3, m0, m1, m2) local(g, k, aa)
(
aa = exp(db * 0.05756462732485114);
g = tan($pi * min(f, srate * 0.49) / srate) * sqrt(aa); k = 1 / q;
a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
m0 = aa * aa; m1 = k * (1 - aa) * aa; m2 = 1 - aa * aa;
);
function svf_l(v0) instance(a1, a2, a3, m0, m1, m2, l1, l2) local(v1, v2, v3)
(
v3 = v0 - l2; v1 = a1 * l1 + a2 * v3; v2 = l2 + a2 * l1 + a3 * v3;
l1 = 2 * v1 - l1; l2 = 2 * v2 - l2;
m0 * v0 + m1 * v1 + m2 * v2
);
function svf_r(v0) instance(a1, a2, a3, m0, m1, m2, r1, r2) local(v1, v2, v3)
(
v3 = v0 - r2; v1 = a1 * r1 + a2 * v3; v2 = r2 + a2 * r1 + a3 * v3;
r1 = 2 * v1 - r1; r2 = 2 * v2 - r2;
m0 * v0 + m1 * v1 + m2 * v2
);
function tick_all()
(
in_g.sm_tick(); pol.sm_tick(); hpf_mix.sm_tick(); lpf_mix.sm_tick();
drv_g.sm_tick(); drv_b.sm_tick(); drv_tb.sm_tick(); drv_comp.sm_tick(); drv_m.sm_tick();
sat_x.sm_tick(); drv_compt.sm_tick(); tp_hf.sm_tick();
gate_mix.sm_tick(); g_thr.sm_tick(); g_range.sm_tick();
eq_mix.sm_tick();
comp_mix.sm_tick(); c_thr.sm_tick(); c_slope.sm_tick(); c_mk.sm_tick();
cho_rate.sm_tick(); cho_depth.sm_tick(); cho_mix.sm_tick();
dly_fb.sm_tick(); dly_mix.sm_tick();
rev_fb.sm_tick(); rev_damp.sm_tick(); rev_mix.sm_tick();
width.sm_tick(); out_g.sm_tick(); pan_l.sm_tick(); pan_r.sm_tick();
dly_time.v += sm_slow * (dly_time.t - dly_time.v);
);
function near_all()
(
in_g.sm_near(); pol.sm_near(); hpf_mix.sm_near(); lpf_mix.sm_near();
drv_g.sm_near(); drv_b.sm_near(); drv_tb.sm_near(); drv_comp.sm_near(); drv_m.sm_near();
sat_x.sm_near(); drv_compt.sm_near(); tp_hf.sm_near();
gate_mix.sm_near(); g_thr.sm_near(); g_range.sm_near();
eq_mix.sm_near();
comp_mix.sm_near(); c_thr.sm_near(); c_slope.sm_near(); c_mk.sm_near();
cho_rate.sm_near(); cho_depth.sm_near(); cho_mix.sm_near();
dly_fb.sm_near(); dly_mix.sm_near(); dly_time.sm_near();
rev_fb.sm_near(); rev_damp.sm_near(); rev_mix.sm_near();
width.sm_near(); out_g.sm_near(); pan_l.sm_near(); pan_r.sm_near();
);
function snap_all()
(
in_g.sm_snap(); pol.sm_snap(); hpf_mix.sm_snap(); lpf_mix.sm_snap();
drv_g.sm_snap(); drv_b.sm_snap(); drv_tb.sm_snap(); drv_comp.sm_snap(); drv_m.sm_snap();
sat_x.sm_snap(); drv_compt.sm_snap(); tp_hf.sm_snap();
gate_mix.sm_snap(); g_thr.sm_snap(); g_range.sm_snap();
eq_mix.sm_snap();
comp_mix.sm_snap(); c_thr.sm_snap(); c_slope.sm_snap(); c_mk.sm_snap();
cho_rate.sm_snap(); cho_depth.sm_snap(); cho_mix.sm_snap();
dly_fb.sm_snap(); dly_mix.sm_snap(); dly_time.sm_snap();
rev_fb.sm_snap(); rev_damp.sm_snap(); rev_mix.sm_snap();
width.sm_snap(); out_g.sm_snap(); pan_l.sm_snap(); pan_r.sm_snap();
);
function ctl_tick()
(
f_hpf.sm_ctl(); f_lpf.sm_ctl(); sc_f.sm_ctl(); tp_bg.sm_ctl();
ls_f.sm_ctl(); ls_g.sm_ctl();
lm_f.sm_ctl(); lm_q.sm_ctl(); lm_g.sm_ctl();
hm_f.sm_ctl(); hm_q.sm_ctl(); hm_g.sm_ctl();
hs_f.sm_ctl(); hs_g.sm_ctl();
);
function ctl_snap()
(
f_hpf.sm_snap(); f_lpf.sm_snap(); sc_f.sm_snap(); tp_bg.sm_snap();
ls_f.sm_snap(); ls_g.sm_snap();
lm_f.sm_snap(); lm_q.sm_snap(); lm_g.sm_snap();
hm_f.sm_snap(); hm_q.sm_snap(); hm_g.sm_snap();
hs_f.sm_snap(); hs_g.sm_snap();
);
function update_filters()
(
hpf.svf_hp(f_hpf.v, 0.7071);
lpf.svf_lp(f_lpf.v, 0.7071);
schp.svf_hp(sc_f.v, 0.7071);
tp_bump.svf_bell(75, 0.8, tp_bg.v);
eq_ls.svf_ls(ls_f.v, 0.7071, ls_g.v);
eq_lm.svf_bell(lm_f.v, lm_q.v, lm_g.v);
eq_hm.svf_bell(hm_f.v, hm_q.v, hm_g.v);
eq_hs.svf_hs(hs_f.v, 0.7071, hs_g.v);
);
function set_dly_target() local(n)
(
n = dly_sync > 0 ? dly_div[dly_sync] * 60 / max(tempo, 1) * srate : slider36 * 0.001 * srate;
dly_time.t = max(1, min(dly_len - 2, n));
);
function update_targets() local(d, g, b, tb, p)
(
in_g.t = db2lin(slider1);
hpf_mix.t = slider2; f_hpf.t = slider3;
lpf_mix.t = slider4; f_lpf.t = slider5;
d = slider6 * 0.01;
g = db2lin(d * 18); b = 0.15 * d; tb = tanh_(b);
drv_g.t = g; drv_b.t = b; drv_tb.t = tb;
drv_comp.t = 1 / (sqrt(g) * (1 - tb * tb));
drv_m.t = min(1, d * 4);
sat_x.t = slider47;
drv_compt.t = 1 / sqrt(g);
tp_hf.t = 1 - exp(-2 * $pi * (20000 - 10000 * d) / srate);
tp_bg.t = 2.5 * d;
pol.t = slider7 ? -1 : 1;
gate_mix.t = 1 - slider8;
g_thr.t = db2lin(slider9);
g_att = 1 - exp(-1 / (slider10 * 0.001 * srate));
g_rel = 1 - exp(-1 / (slider11 * 0.001 * srate));
g_range.t = db2lin(slider12);
ord = slider13;
eq_mix.t = 1 - slider14;
ls_f.t = slider15; ls_g.t = slider16;
lm_f.t = slider17; lm_q.t = slider18; lm_g.t = slider19;
hm_f.t = slider20; hm_q.t = slider21; hm_g.t = slider22;
hs_f.t = slider23; hs_g.t = slider24;
comp_mix.t = 1 - slider25;
c_thr.t = slider26;
c_slope.t = 1 / max(1, slider27) - 1;
c_att = 1 - exp(-1 / (slider28 * 0.001 * srate));
c_rel = 1 - exp(-1 / (slider29 * 0.001 * srate));
sc_on = slider30 >= 20;
sc_f.t = max(20, slider30);
c_mk.t = db2lin(slider31);
cho_rate.t = slider32 * 2 * $pi / srate;
cho_depth.t = slider33 * 0.01 * 0.010 * srate;
cho_mix.t = slider34 * 0.01;
dly_sync = slider35;
set_dly_target();
dly_fb.t = slider37 * 0.01;
dly_mix.t = slider38 * 0.01;
rev_fb.t = 0.7 + slider39 * 0.01 * 0.28;
rev_damp.t = slider40 * 0.01 * 0.85;
rev_mix.t = slider41 * 0.01;
width.t = slider46 ? 0 : slider42 * 0.01;
out_g.t = slider45 ? 0 : db2lin(slider43);
p = slider44 * 0.01;
pan_l.t = p > 0 ? 1 - p : 1;
pan_r.t = p < 0 ? 1 + p : 1;
ctl_active = ctl_ticks;
);
function tape_ch(x) instance(s1, s2, s3) local(y)
(
s1 += tp_ec * (x - s1);
y = (x + tp_k * (x - s1)) * drv_g.v;
y = y / sqrt(1 + y * y);
s2 += tp_dc * (y - s2);
y -= tp_kd * (y - s2);
s3 += tp_hf.v * (y - s3);
s3 * drv_compt.v
);
function do_eq() local(el, er)
(
eq_mix.v > 0.00001 ? (
el = eq_hs.svf_l(eq_hm.svf_l(eq_lm.svf_l(eq_ls.svf_l(l))));
er = eq_hs.svf_r(eq_hm.svf_r(eq_lm.svf_r(eq_ls.svf_r(r))));
l += eq_mix.v * (el - l);
r += eq_mix.v * (er - r);
);
);
function do_comp() local(sl, sr, over, gr, cg)
(
comp_mix.v > 0.00001 ? (
sc_on ? ( sl = schp.svf_l(l); sr = schp.svf_r(r); ) : ( sl = l; sr = r; );
over = lin2db(max(abs(sl), abs(sr))) - c_thr.v;
gr = over <= -3 ? 0 : ( over >= 3 ? c_slope.v * over : c_slope.v * (over + 3) * (over + 3) / 12 );
c_env += (gr < c_env ? c_att : c_rel) * (gr - c_env);
abs(c_env) < 0.000001 ? c_env = 0;
cg = 1 + comp_mix.v * (exp(c_env * 0.11512925464970228) * c_mk.v - 1);
l *= cg; r *= cg;
comp_min = min(comp_min, c_env * comp_mix.v);
) : ( c_env = 0; );
);
function mtr_update(pk, dt, now) instance(d, h, ht) local(db)
(
db = lin2db(pk);
d = max(db, max(-140, d - 40 * dt));
db >= h ? ( h = db; ht = now; ) : ( now - ht > 1.5 ? h = max(-140, h - 40 * dt); );
);
function gr_update(gr, dt) instance(d) ( d = min(0, min(gr, d + 30 * dt)); );
sm_c     = 1 - exp(-1 / (0.015 * srate));
sm_slow  = 1 - exp(-1 / (0.120 * srate));
ctl_c    = 1 - exp(-16 / (0.030 * srate));
ctl_ticks = ceil(0.35 * srate / 16);
g_holdlen = 0.02 * srate;
cho_base  = 0.005 * srate;
tp_k  = 1.5;
tp_ec = 1 - exp(-2 * $pi * 3000 / srate);
tp_dc = 1 - exp(-2 * $pi * 3000 / (1 + tp_k) / srate);
tp_kd = tp_k / (1 + tp_k);
mem_top = 0;
dly_div = alloc(16);
dly_div[1] = 4;     dly_div[2] = 2;     dly_div[3] = 1.5;
dly_div[4] = 1;     dly_div[5] = 2 / 3; dly_div[6] = 0.75;
dly_div[7] = 0.5;   dly_div[8] = 1 / 3; dly_div[9] = 0.375;
dly_div[10] = 0.25; dly_div[11] = 1 / 6; dly_div[12] = 0.125;
rv_tun = alloc(12);
rv_tun[0] = 1116; rv_tun[1] = 1188; rv_tun[2] = 1277; rv_tun[3] = 1356;
rv_tun[4] = 1422; rv_tun[5] = 1491; rv_tun[6] = 1557; rv_tun[7] = 1617;
rv_tun[8] = 556;  rv_tun[9] = 441;  rv_tun[10] = 341; rv_tun[11] = 225;
k_min = alloc(64); k_max = alloc(64); k_def = alloc(64); k_log = alloc(64); k_fmt = alloc(64);
function kdef(i, mn, mx, df, lg, fm) ( k_min[i] = mn; k_max[i] = mx; k_def[i] = df; k_log[i] = lg; k_fmt[i] = fm; );
kdef(1, -24, 24, 0, 0, 0);
kdef(3, 20, 500, 80, 1, 1);        kdef(5, 3000, 20000, 18000, 1, 1);
kdef(6, 0, 100, 0, 0, 3);
kdef(9, -80, 0, -50, 0, 0);        kdef(10, 0.1, 50, 1, 1, 2);
kdef(11, 10, 1000, 150, 1, 2);     kdef(12, -60, 0, -40, 0, 0);
kdef(15, 40, 500, 100, 1, 1);      kdef(16, -15, 15, 0, 0, 0);
kdef(17, 100, 3000, 400, 1, 1);    kdef(18, 0.5, 4, 1, 1, 5);   kdef(19, -15, 15, 0, 0, 0);
kdef(20, 800, 10000, 3000, 1, 1);  kdef(21, 0.5, 4, 1, 1, 5);   kdef(22, -15, 15, 0, 0, 0);
kdef(23, 3000, 16000, 8000, 1, 1); kdef(24, -15, 15, 0, 0, 0);
kdef(26, -60, 0, 0, 0, 0);         kdef(27, 1, 20, 3, 1, 4);
kdef(28, 0.5, 100, 10, 1, 2);      kdef(29, 10, 1000, 150, 1, 2);
kdef(30, 0, 300, 0, 0, 7);         kdef(31, -12, 24, 0, 0, 0);
kdef(32, 0.05, 8, 0.8, 1, 6);      kdef(33, 0, 100, 40, 0, 3);  kdef(34, 0, 100, 0, 0, 3);
kdef(36, 1, 2000, 350, 1, 2);      kdef(37, 0, 95, 30, 0, 3);   kdef(38, 0, 100, 0, 0, 3);
kdef(39, 0, 100, 50, 0, 3);        kdef(40, 0, 100, 50, 0, 3);  kdef(41, 0, 100, 0, 0, 3);
kdef(42, 0, 200, 100, 0, 3);       kdef(43, -24, 12, 0, 0, 0);  kdef(44, -100, 100, 0, 0, 8);
vu_c = 1 - exp(-1 / (0.1 * srate));
vu_in = vu_out = 0;
cb_buf = alloc(16); cb_len = alloc(16); cb_idx = alloc(16); cb_st = alloc(16);
ap_buf = alloc(8);  ap_len = alloc(8);  ap_idx = alloc(8);
qr_n = 45;
qr_row = alloc(64);
qr_row[0] = "111111100000011010101100001000110000101111111";
qr_row[1] = "100000100110000000110110000111000101001000001";
qr_row[2] = "101110101011101110101110000001110101001011101";
qr_row[3] = "101110101110010100100101101001100001101011101";
qr_row[4] = "101110101111111010101111100010010111101011101";
qr_row[5] = "100000101101010000111000110100011000001000001";
qr_row[6] = "111111101010101010101010101010101010101111111";
qr_row[7] = "000000001010010010101000110101010001100000000";
