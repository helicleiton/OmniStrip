function p_in(hon, hf, lon, lf, drv, tape)
(
setv(2, hon); setv(3, hf); setv(4, lon); setv(5, lf); setv(6, drv); setv(47, tape);
);
function preset_input(n)
(
n == 1 ? ( setv(1, 0); setv(7, 0); p_in(0, 80, 0, 18000, 0, 0); );
n == 2 ? p_in(1, 90, 0, 18000, 10, 0);
n == 3 ? p_in(1, 80, 0, 18000, 15, 1);
n == 4 ? p_in(1, 100, 1, 10000, 25, 0);
n == 5 ? p_in(1, 35, 1, 8000, 35, 1);
n == 6 ? p_in(1, 40, 0, 18000, 40, 0);
n == 7 ? p_in(0, 80, 1, 16000, 45, 1);
n == 8 ? p_in(1, 30, 1, 14000, 75, 1);
n == 9 ? p_in(1, 200, 1, 5000, 60, 1);
);
function p_gate(thr, att, rel, rng)
(
setv(8, 0); setv(9, thr); setv(10, att); setv(11, rel); setv(12, rng);
);
