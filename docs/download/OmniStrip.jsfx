ltext(520, 17, "ARRASTE = AJUSTAR    SHIFT = FINO    DUPLO CLIQUE = RESET");
cream(0.8); ltext(880, 17, "POWER");
cream(0.55); ctext(500, 421, "Desenvolvido por @helicleiton  -  helicleiton.com");
);
