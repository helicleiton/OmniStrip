qr_row[19] = "110001001110011011101100100101111001000110001";
qr_row[20] = "011011111000011110011111100101001101111111001";
qr_row[21] = "101110001011101001001000100110100000100010100";
qr_row[22] = "001010101001000111001010101100001001101011010";
qr_row[23] = "000110001110111000011000111100000001100010101";
