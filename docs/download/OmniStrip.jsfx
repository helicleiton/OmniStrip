k += 1;
);
gfx_set(kc_r * m * 0.5, kc_g * m * 0.5, kc_b * m * 0.5, 1); circ(cx, cy, r * 0.72, 1);
gfx_set(kc_r * m, kc_g * m, kc_b * m, 1);                   circ(cx, cy - 0.5, r * 0.64, 1);
gfx_set(1, 1, 1, 0.10); circ(cx - r * 0.10, cy - r * 0.12, r * 0.46, 1);
gfx_set(1, 1, 1, 0.20); circ(cx - r * 0.16, cy - r * 0.20, r * 0.28, 1);
gfx_set(0, 0, 0, 0.60); circ(cx, cy, r * 0.72, 0);
a = (-135 + n * 270) * $pi / 180; sa = sin(a); ca = cos(a);
gfx_set(0.98, 0.96, 0.90, dis ? 0.6 : 1);
sline(cx + sa * r * 0.15, cy - ca * r * 0.15, cx + sa * r * 0.96, cy - ca * r * 0.96);
sline(cx + sa * r * 0.15 + ca * 0.8, cy - ca * r * 0.15 + sa * 0.8, cx + sa * r * 0.96 + ca * 0.8, cy - ca * r * 0.96 + sa * 0.8);
gfx_setfont(1); cream(dis ? 0.45 : 0.95);
ctext(cx, cy + r + 9, label);
gfx_setfont(2);
(hov || drag_id == i) ? gfx_set(1, 0.80, 0.35, 1) : gfx_set(0.95, 0.70, 0.30, dis ? 0.4 : 0.75);
