n = ceil(22 * zs); k = 0;
loop(n,
c = 0.80 + 0.35 * rand(1) + 0.15 * sin(k * 0.9);
gfx_set(0.34 * c, 0.18 * c, 0.08 * c, 1);
gfx_line(sx(0) + k, sy(0), sx(0) + k, sy(436), 0);
c = 0.80 + 0.35 * rand(1) + 0.15 * sin(k * 1.3);
