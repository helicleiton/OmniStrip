function setv(i, v) ( slider(i) = v; auto(i); ui_changed = 1; );
function knorm(i) local(mn, mx, v)
(
mn = k_min[i]; mx = k_max[i]; v = slider(i);
k_log[i] ? log(v / mn) / log(mx / mn) : (v - mn) / (mx - mn)
);
function kval(i, n) local(mn, mx)
(
mn = k_min[i]; mx = k_max[i]; n = max(0, min(1, n));
k_log[i] ? mn * exp(n * log(mx / mn)) : mn + n * (mx - mn)
);
function fmtval(i) local(v, f)
(
v = slider(i); f = k_fmt[i];
f == 0 ? sprintf(#val, "%.1f dB", v);
f == 1 ? ( v >= 1000 ? sprintf(#val, "%.2f kHz", v * 0.001) : sprintf(#val, "%.0f Hz", v); );
f == 2 ? ( v < 10 ? sprintf(#val, "%.1f ms", v) : sprintf(#val, "%.0f ms", v); );
f == 3 ? sprintf(#val, "%.0f %%", v);
f == 4 ? sprintf(#val, "%.1f : 1", v);
f == 5 ? sprintf(#val, "Q %.2f", v);
f == 6 ? sprintf(#val, "%.2f Hz", v);
f == 7 ? ( v < 20 ? strcpy(#val, "OFF") : sprintf(#val, "%.0f Hz", v); );
f == 8 ? ( abs(v) < 0.5 ? strcpy(#val, "C") : ( v < 0 ? sprintf(#val, "L %.0f", -v) : sprintf(#val, "R %.0f", v) ); );
);
