gfx_set(0, 0, 0, 0.45); frect(20, 0, 2, 436);  frect(998, 0, 2, 436);
gfx_gradrect(sx(22), sy(0), 956 * zs, 436 * zs, 0.17, 0.18, 0.20, 1,
0, 0, 0, 0, -0.00012 / zs, -0.00012 / zs, -0.00012 / zs, 0);
n = floor(436 * zs); xa = sx(22); yy = sy(0); k = 0;
loop(n,
rand(1) < 0.5 ? gfx_set(1, 1, 1, 0.04 * rand(1)) : gfx_set(0, 0, 0, 0.10 * rand(1));
gfx_line(xa, yy + k, sx(978) - 1, yy + k, 0);
k += 1;
);
gfx_set(1, 1, 1, 0.14); frect(22, 0, 956, 1.5);
gfx_set(0, 0, 0, 0.50); frect(22, 434, 956, 2);
plate(32, 44, 300, 120);  plate(340, 44, 252, 120); plate(600, 44, 368, 120);
plate(32, 170, 600, 120); plate(640, 170, 328, 120);
plate(32, 296, 194, 120); plate(234, 296, 270, 120); plate(512, 296, 194, 120); plate(714, 296, 254, 120);
screw(36, 21); screw(964, 21); screw(36, 426); screw(964, 426);
gfx_set(0, 0, 0, 0.5);        frect(55, 6, 334, 32);
gfx_set(0.03, 0.03, 0.04, 1); frect(56, 7, 330, 28);
gfx_set(0.80, 0.68, 0.38, 0.8);
frect(56, 7, 330, 1); frect(56, 34, 330, 1); frect(56, 7, 1, 28); frect(385, 7, 1, 28);
gfx_setfont(3); cream(1);     ltext(66, 9, "OMNISTRIP");
gfx_setfont(5); gfx_set(0.95, 0.70, 0.30, 0.9);
ltext(212, 12, "ULTIMATE CHANNEL STRIP");
