function btn(i, x, y, w, h, label, onval, cr, cg, cb) local(lit)
(
( drag_id == 0 && m_click && inbox(x, y, w, h) ) ? setv(i, slider(i) ? 0 : 1);
lit = slider(i) == onval;
lit ? ( gfx_set(cr, cg, cb, 0.22); frect(x - 3.5, y - 3.5, w + 7, h + 7); );
gfx_set(0.04, 0.04, 0.05, 1); frect(x - 1.5, y - 1.5, w + 3, h + 3);
