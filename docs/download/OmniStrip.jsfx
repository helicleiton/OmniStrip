(
n == 1 ? ( p_gate(-50, 1, 150, -40); setv(8, 1); );
n == 2 ? p_gate(-45, 2, 250, -15);
n == 3 ? p_gate(-30, 0.5, 120, -40);
n == 4 ? p_gate(-28, 0.3, 180, -30);
n == 5 ? p_gate(-32, 0.5, 350, -50);
n == 6 ? p_gate(-50, 1, 200, -40);
n == 7 ? p_gate(-40, 5, 400, -10);
n == 8 ? p_gate(-35, 0.1, 60, -60);
);
function p_comp(thr, ratio, att, rel, sc, mk)
(
setv(25, 0); setv(26, thr); setv(27, ratio); setv(28, att); setv(29, rel); setv(30, sc); setv(31, mk);
);
function preset_comp(n)
(
n == 1 ? ( p_comp(0, 3, 10, 150, 0, 0); setv(25, 1); );
n == 2 ? p_comp(-20, 3, 10, 150, 80, 4);
n == 3 ? p_comp(-24, 6, 3, 80, 100, 7);
