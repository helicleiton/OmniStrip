function circ(x, y, r, fill) ( gfx_circle(sx(x), sy(y), r * zs, fill, 1); );
function ltext(x, y, str) ( gfx_x = sx(x); gfx_y = sy(y); gfx_drawstr(str); );
function ctext(cx, y, str) local(tw, th)
