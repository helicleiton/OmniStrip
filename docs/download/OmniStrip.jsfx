);
function plate(x, y, w, h) local(k, n, xa, xb, yy)
(
gfx_set(0, 0, 0, 0.30); frect(x - 2, y - 1, w + 5, h + 5);
gfx_set(0, 0, 0, 0.45); frect(x - 1, y, w + 3, h + 3);
gfx_gradrect(sx(x), sy(y), w * zs, h * zs, 0.40, 0.46, 0.50, 1,
0, 0, 0, 0, -0.08 / (h * zs), -0.08 / (h * zs), -0.08 / (h * zs), 0);
n = floor(h * zs); xa = sx(x); xb = sx(x + w) - 1; yy = sy(y); k = 0;
loop(n,
rand(1) < 0.5 ? gfx_set(1, 1, 1, 0.06 * rand(1)) : gfx_set(0, 0, 0, 0.09 * rand(1));
gfx_line(xa, yy + k, xb, yy + k, 0);
k += 1;
);
gfx_set(0.08, 0.09, 0.11, 1); frect(x, y, w, 20);
gfx_set(0, 0, 0, 0.55);       frect(x, y + 20, w, 1);
gfx_set(1, 1, 1, 0.12);       frect(x, y + 21, w, 1);
gfx_set(1, 1, 1, 0.24); frect(x, y, w, 1); frect(x, y, 1, h);
gfx_set(0, 0, 0, 0.55); frect(x, y + h - 1, w, 1); frect(x + w - 1, y, 1, h);
mscrew(x + 8, y + 10); mscrew(x + w - 8, y + 10);
mscrew(x + 8, y + h - 8); mscrew(x + w - 8, y + h - 8);
);
