function sync_name(i)
(
strcpy(#sync, "FREE");
i == 1 ? strcpy(#sync, "1/1");    i == 2 ? strcpy(#sync, "1/2");
i == 3 ? strcpy(#sync, "1/4 D");  i == 4 ? strcpy(#sync, "1/4");
i == 5 ? strcpy(#sync, "1/4 T");  i == 6 ? strcpy(#sync, "1/8 D");
i == 7 ? strcpy(#sync, "1/8");    i == 8 ? strcpy(#sync, "1/8 T");
i == 9 ? strcpy(#sync, "1/16 D"); i == 10 ? strcpy(#sync, "1/16");
i == 11 ? strcpy(#sync, "1/16 T"); i == 12 ? strcpy(#sync, "1/32");
);
now = time_precise();
dt = max(0, min(0.25, now - gfx_last)); gfx_last = now;
m_in_l.mtr_update(pk_in_l, dt, now);   pk_in_l = 0;
m_in_r.mtr_update(pk_in_r, dt, now);   pk_in_r = 0;
m_out_l.mtr_update(pk_out_l, dt, now); pk_out_l = 0;
m_out_r.mtr_update(pk_out_r, dt, now); pk_out_r = 0;
gr_gate.gr_update(lin2db(gate_min), dt); gate_min = 1;
gr_comp.gr_update(comp_min, dt);         comp_min = 0;
ndl_k = min(1, dt * 14);
ndl_in  += (min(1.05, sqrt(vu_in) * 7.943) - ndl_in) * ndl_k;
ndl_out += (min(1.05, sqrt(vu_out) * 7.943) - ndl_out) * ndl_k;
ndl_gr  += (max(0, 1 + gr_comp.d / 20) - ndl_gr) * ndl_k;
zs = max(0.5, min(gfx_w / 1000, gfx_h / 436));
ox = max(0, (gfx_w - 1000 * zs) * 0.5); oy = 0;
gfx_setfont(1, "Arial", max(8, floor(11 * zs + 0.5)), 'b');
gfx_setfont(2, "Arial", max(8, floor(10 * zs + 0.5)));
gfx_setfont(3, "Arial", max(12, floor(22 * zs + 0.5)), 'b');
gfx_setfont(4, "Courier New", max(9, floor(14 * zs + 0.5)), 'b');
gfx_setfont(5, "Arial", max(7, floor(9 * zs + 0.5)), 'b');
gfx_setfont(6, "Arial", max(9, floor(15 * zs + 0.5)), 'b');
m_click  = (mouse_cap & 1) && !m_last;
m_rclick = (mouse_cap & 2) && !m_rlast;
ui_changed = 0;
ab_click = 0;
about_open ? ( ab_click = m_click; m_click = 0; m_rclick = 0; mouse_wheel = 0; );
( zs != c_zs || gfx_w != c_w || gfx_h != c_h ) ? (
c_zs = zs; c_w = gfx_w; c_h = gfx_h;
gfx_setimgdim(1, gfx_w, gfx_h);
gfx_dest = 1;
draw_chassis();
gfx_dest = -1;
);
gfx_mode = 0; gfx_a = 1; gfx_x = 0; gfx_y = 0;
gfx_blit(1, 1, 0);
about_btn(404, 13, 70, 17);
gmem[0] > om_versao ? draw_update(gmem[0], gmem[1]);
